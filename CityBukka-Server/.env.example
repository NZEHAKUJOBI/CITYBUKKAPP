PORT=8080
# Set to "production" in production (disables the dev admin login defaults)
NODE_ENV=development

# PostgreSQL connection (required). The database is created on first start if the user may
# CREATEDB; migrations in src/db/migrations run automatically. Nothing is seeded.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/citybukka
# Hosted databases: "true" = TLS with certificate verification, "no-verify" = TLS accepting any
# certificate (some managed providers). PGSSL is accepted as an alias.
DATABASE_SSL=false
# Tests use TEST_DATABASE_URL, or DATABASE_URL with "_test" appended to the database name.
# TEST_DATABASE_URL=

# Comma-separated origins allowed to call the API (the PWA's URL in production)
CORS_ORIGINS=http://localhost:5000,http://localhost:8000,http://localhost:5173

# Signs customer and rider session tokens (HMAC-SHA256, 30 days). Generate a long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# If unset a random one is used per process, so everyone is logged out on every restart.
AUTH_TOKEN_SECRET=

# Admin dashboard login (POST /api/admin/login). Outside production these default to
# admin@citybukka.local / changeme; in production login is disabled until both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Signs admin session tokens (12 hours). Same advice as AUTH_TOKEN_SECRET; use a different value.
ADMIN_TOKEN_SECRET=
# Optional legacy static bearer key for scripts / integrations. Leave empty to disable.
ADMIN_API_KEY=

# Where uploaded images are stored; served at /uploads/*
UPLOAD_DIR=./data/uploads
