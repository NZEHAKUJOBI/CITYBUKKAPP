# Environment for docker-compose.yml (Dokploy → Compose service → Environment tab).
# Copy, fill in, and paste into Dokploy. Never commit real values.
# Generate each secret separately: openssl rand -hex 32
# POSTGRES_PASSWORD must be hex/alphanumeric: @ : / # would break DATABASE_URL.
# Keep all values after the first deploy (changing them logs users out / locks out the database).
POSTGRES_USER=citybukka
POSTGRES_DB=citybukka
POSTGRES_PASSWORD=
AUTH_TOKEN_SECRET=
ADMIN_TOKEN_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
